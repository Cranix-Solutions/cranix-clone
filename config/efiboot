timeout=1

menuentry 'Automatic Cloning' {
  echo 'Loading kernel ...'
  linux boot/linux root=live:ftp://install/boot/squashfs.img ip=dhcp STARTCMD=clone SLEEP=1 dhcptimeout=120 insecure=1 PARTITIONS=#PARTITIONS# MODUS=AUTO MULTICAST=1 2
  echo 'Loading initial ramdsik ...'
  initrd boot/initrd
}

